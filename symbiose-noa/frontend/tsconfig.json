{
  "compilerOptions": {
    /* ES2017 : la cible par défaut de Next 15. En es5, itérer un Set ou une Map
       exige --downlevelIteration, et les composants du registre shadcn
       (AI Elements, Extend UI) ne compilent pas. Les navigateurs visés
       supportent tous ES2017. */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

# Serveur
HEADSCALE_IP=100.64.0.1  # IP assignee par Headscale a ce serveur

# ── HTTPS (optionnel) — voir docker-compose.https.yml ──
# A remplir SEULEMENT si vous ajoutez -f docker-compose.https.yml :
# HEADSCALE_IP doit alors passer a 127.0.0.1 (nginx repasse en interne).
# VPN_IP=100.64.0.1
# APP_HOSTNAME=symbiose.pluton-consulting.fr
# ACME_EMAIL=
# GANDI_API_TOKEN=       # PAT Gandi, PAS une cle API LiveDNS

# PostgreSQL
POSTGRES_DB=symbiose_noa
POSTGRES_USER=noa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://noa_user:CHANGE_ME@postgres:5432/symbiose_noa

# Magic Link — Resend (resend.com — gratuit jusqu'à 3 000 emails/mois)
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=IA-SYMBIOSE <IA-SYMBIOSE@benit.fr>
APP_URL=http://100.64.0.1  # URL publique du frontend (IP Headscale)

# NextAuth
NEXTAUTH_URL=http://100.64.0.1  # Remplacer par l'IP Headscale reelle
#  en HTTPS : https://symbiose.pluton-consulting.fr
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# JWT Backend
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# LLM — Claude API (Anthropic)
ANTHROPIC_API_KEY=

# LLM — Ollama local (optionnel)
# ── Ollama CLOUD (abonnement) ───────────────────────────────────────────
# À NE PAS CONFONDRE avec OLLAMA_BASE_URL juste en dessous, qui désigne un
# Ollama LOCAL sans clé (dernier recours hors ligne). La clé se saisit aussi
# dans Paramètres → Clés API, qui PRIME sur ce fichier.
OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# Identifiants tels que les sert /v1/models, SANS le suffixe « :cloud ».
# MODEL_OLLAMA_CLOUD_RAPIDE=deepseek-v4-flash:0731
# MODEL_OLLAMA_CLOUD_PUISSANT=deepseek-v4-pro:0813
# MODEL_OLLAMA_CLOUD_VISION=qwen3.5:397b

# Appels de modèle simultanés (l'abonnement en autorise 10 ; on garde une marge).
# Le plafond global se règle aussi dans Paramètres → Clés API.
# LLM_SIMULTANES=8
# LLM_SIMULTANES_PERSONNE=3
# LLM_SIMULTANES_FOND=2
# LLM_ATTENTE_MAX_S=90

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LIGHT=mistral:7b

# Langfuse
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Daytona (optionnel — phase 2)
# Laisser vide pour utiliser le fallback subprocess local
# Obtenir sur https://app.daytona.io
DAYTONA_API_KEY=

# ── Ingestion (connecteurs + extraction navigateur) ─────────────────────
# Secret partagé du webhook d'ingestion (Make.com + agent navigateur → RAG)
INGESTION_WEBHOOK_SECRET=

# ── Agent Navigateur agentique (browser-use, conteneur browser-worker) ──
BROWSER_AGENT_ENABLED=false                # true pour activer
BROWSER_WORKER_URL=http://browser-worker:9000
BROWSER_LLM_PROVIDER=openrouter           # deepseek | groq | openrouter | longcat | openai
BROWSER_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free   # free + tool-calling (rate-limité)
BROWSER_AGENT_MAX_STEPS=40
BROWSER_APPROVAL_TIMEOUT_S=1800
BROWSER_USE_VISION=false
BROWSER_READONLY=true                     # sécurité : pas de saisie/soumission de formulaire (recommandé)
# Allowlist stricte des domaines autorisés (CSV). Vide = aucune tâche possible.
BROWSER_ALLOWED_DOMAINS=
# Clé du provider choisi ci-dessus (au moins une requise pour activer) :
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GROQ_API_KEY=
OPENROUTER_API_KEY=
# L'OCR des images passe par ce modèle de vision, via la clé OpenRouter
# ci-dessus (01/09) : il lit les scans et factures bien mieux que tesseract.
# Laisser vide garde le défaut du code (google/gemini-2.5-pro) ; sans clé
# OpenRouter, la cascade vision retombe seule sur Gemini direct.
MODEL_OPENROUTER_VISION=google/gemini-2.5-pro
LONGCAT_API_KEY=

# ── Embeddings RAG (base vectorielle) ───────────────────────────────────
# gemini = gratuit, 1536 dims natif (aucune migration), idéal petit VPS.
EMBEDDING_PROVIDER=gemini                  # gemini | openai | ollama
GOOGLE_API_KEY=                            # Google AI Studio (aistudio.google.com) — tier gratuit
# OPENAI_API_KEY=                          # si EMBEDDING_PROVIDER=openai
# OLLAMA_EMBEDDING_MODEL=bge-m3            # si EMBEDDING_PROVIDER=ollama (⚠ 1024 dims → migration schéma)
EMBEDDING_WORKER_ENABLED=true

# ── Google Drive d'entreprise ───────────────────────────────────────────
# Deux voies d'authentification, la première trouvée l'emporte :
#   1. backend/secrets/google_service_account.json — compte de service.
#      Google BLOQUE désormais la création de ces clés par défaut au niveau
#      organisation (iam.disableServiceAccountKeyCreation).
#   2. backend/secrets/google_credentials.json + google_token.json — client
#      OAuth « Application de bureau » et jeton de rafraîchissement, produit
#      UNE fois par `python scripts/google_consentement.py`. Aucune clé créée,
#      donc aucune règle d'administration à lever. Personne d'autre n'a jamais
#      à se connecter à Google.
# Ces deux fichiers valent un accès en lecture au Drive : ils se traitent comme
# des mots de passe, et `secrets/` est ignoré par git.

# Dossier à ingérer. Vide = tout ce que le compte peut voir, Drive partagés
# compris. Le renseigner est le moyen le plus simple de n'exposer qu'une partie.
GOOGLE_DRIVE_FOLDER_ID=

# QUI pourra lire ces documents dans l'assistant. Un Drive d'entreprise mélange
# souvent dossiers de chantier et dossiers du personnel : au niveau « all »,
# tout devient consultable par n'importe quel rôle. À décider AVANT la première
# synchronisation — après, les documents sont déjà indexés.
# all | commercial_plus | bureau_etudes_plus | direction_only | admin_only
GOOGLE_DRIVE_ACCESS_LEVEL=all

# DÉCOUPAGE PAR SERVICE — un dossier, un niveau. Remplace les deux réglages
# ci-dessus quand il est renseigné. Un seul identifiant Google suffit : c'est le
# niveau du document qui décide qui le retrouve, pas le compte qui l'a lu.
# GOOGLE_DRIVE_PERIMETRES=1AbC_chantiers:all,1DeF_etudes:bureau_etudes_plus,1GhI_rh:direction_only

# App
ENVIRONMENT=production
DEBUG=false
ALLOWED_HOSTS=100.64.0.1

# Secret partage entre le backend et le conteneur navigateur. Celui-ci
# n'ecrit plus en base : il raconte au backend, qui ecrit. Sans ce
# secret, le guichet refuse tout et l'avancement des taches reste fige.
# Generer une valeur au hasard :  openssl rand -hex 32
BROWSER_WORKER_SECRET=
